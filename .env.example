# ─────────────────────────────────────────────────────────────────────────────
# Lumen — environment
#
#   cp .env.example .env    and fill in the values marked REQUIRED.
#
# .env is git-ignored. Never commit real keys. The API refuses to start in
# ENVIRONMENT=prod if any REQUIRED value is still a placeholder.
#
# Nothing here is needed to RUN the product locally except the Supabase block:
# with no LLM key at all, LLM_MODE=auto falls back to the deterministic
# MockProvider and the whole agent flow still works end to end.
#
# NOTE: every comment lives on its own line. Trailing comments after a value
# are parsed as part of that value by python-dotenv, which silently turns an
# empty key into a non-empty string. Keep it this way.
# ─────────────────────────────────────────────────────────────────────────────

# dev | test | prod
ENVIRONMENT=dev


# ── Supabase ─────────────────────────────────────────────────────────────────
# REQUIRED. Project dashboard → Settings → API, and Settings → Database.
#
# Local development with the Supabase CLI (`supabase start`) prints all four;
# the URL is http://127.0.0.1:54321 and the DB port is 54322.

SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Safe to expose to the browser.
SUPABASE_ANON_KEY=

# Server only. Never in the browser bundle, never in a VITE_ variable.
SUPABASE_SERVICE_ROLE_KEY=

# Settings → API → JWT Settings.
#
# LEAVE BLANK if your project uses asymmetric JWT signing keys (ES256/RS256) —
# there is no shared secret to copy, and tokens are verified against the
# project's published JWKS instead. That is the default for new projects.
SUPABASE_JWT_SECRET=

# Direct Postgres, used by the API and the worker (pgvector, pipelines, bulk
# writes). Dashboard → Settings → Database → Connection string → URI, with
# +asyncpg added.
#
# Use the SESSION pooler on port 5432. The transaction pooler on 6543 does not
# carry the SET LOCAL statements our row-level security depends on.
DATABASE_URL=postgresql+asyncpg://postgres:YOUR-DB-PASSWORD@db.YOUR-PROJECT-REF.supabase.co:5432/postgres

# Supabase Storage bucket for uploads and Parquet artefacts. Created on first use.
STORAGE_BUCKET=lumen


# ── LLM providers ────────────────────────────────────────────────────────────
# OPTIONAL. Leave both blank and everything still runs.
#
#   auto       Anthropic if its key is set, else Groq, else the local MockProvider
#   anthropic  force Anthropic; fails loudly with no key
#   groq       force Groq
#   mock       force the deterministic provider (what CI uses)
#   bridge     a human answers each model call through files in LLM_BRIDGE_INBOX

LLM_MODE=auto

# console.anthropic.com → API keys. Starts with sk-ant-
ANTHROPIC_API_KEY=

# console.groq.com → API keys. Starts with gsk_
GROQ_API_KEY=

# Which model each role uses. Configuration, not code — change without a deploy.
# Supervisor: planning a pipeline, judging a schema.
MODEL_REASONING=claude-opus-5
# The context, cleaning and analysis agents.
MODEL_SPECIALIST=claude-sonnet-5
# Groq — cheap classification and summarisation.
MODEL_FAST=qwen/qwen3.6-27b

LLM_BRIDGE_INBOX=.llm-bridge

# Per-run guard rails. A run that hits either stops cleanly with partial results
# retained; it never truncates silently.
AGENT_MAX_ITERATIONS=12
AGENT_DEADLINE_SECONDS=180
AGENT_MAX_TOTAL_TOKENS=120000


# ── Billing (ADR-0004) ─────────────────────────────────────────────────────────
# Absent by default. A plan-change proposal still validates and records a
# decision with no key set — it just can't hand back a real Checkout URL, and
# says so plainly rather than failing. console.stripe.com → Developers → API keys.

# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
APP_BASE_URL=http://localhost:3000


# ── Embeddings ───────────────────────────────────────────────────────────────
# Local by default: BAAI/bge-small-en-v1.5 via fastembed, 384 dimensions, CPU,
# no key and no network at inference time. The model (~130MB) downloads once
# into EMBEDDING_CACHE_DIR.
#
# Changing the model means changing the vector dimension, which means a
# migration — data_contexts.embedding is vector(384).

# fastembed | none
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384
EMBEDDING_CACHE_DIR=.cache/embeddings


# ── Queue ────────────────────────────────────────────────────────────────────
# Redis backs the job queue between the API and the worker.

REDIS_URL=redis://localhost:6379/0


# ── Web ──────────────────────────────────────────────────────────────────────
# Anything prefixed VITE_ is compiled into the browser bundle. Only the anon key
# belongs there.

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=http://localhost:8000

# mock renders the UI from fixtures with no backend; live calls the API.
VITE_DATA_MODE=live

CORS_ORIGINS=["http://localhost:3000"]
